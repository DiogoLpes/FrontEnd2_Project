generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// UTILIZADORES
// ==========================================
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  password  String
  role      Role      @default(USER)
  phone     String?
  vehicles  Vehicle[] // Um user pode ter vários veículos
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ==========================================
// VEÍCULOS
// ==========================================
model Vehicle {
  id        Int           @id @default(autoincrement())
  plate     String        @unique // Matrícula
  brand     String?       // Marca
  model     String?       // Modelo
  color     String?
  year      Int?
  fuel      FuelType?
  imageUrl  String?
  
  // Relacionamento com User (Alterado para userId)
  user      User          @relation(fields: [userId], references: [id])
  userId    Int
  
  services  Service[]     // Histórico de serviços deste veículo
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ==========================================
// SERVIÇOS / MANUTENÇÕES
// ==========================================
model Service {
  id          Int           @id @default(autoincrement())
  type        ServiceType
  description String?
  date        DateTime
  mileage     Int?          // Quilometragem no momento do serviço
  price       Float?
  status      ServiceStatus @default(PENDENTE)
  
  // Relacionamento com Vehicle
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  vehicleId   Int
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ==========================================
// STOCK DE PEÇAS (LOJA/OFICINA)
// ==========================================
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   // Ex: Pneus, Óleos, Travões
  quantity    Int      @default(0)
  minStock    Int      @default(5) // Alerta de stock baixo
  price       Float    // Preço de venda
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id           String   @id @default(cuid())
  plate        String   // Matrícula da viatura
  service      String   // Categoria (PNEUS, REVISAO, etc)
  subService   String?  // Opção detalhada (Michelin, 5W30, etc)
  extraInfo    String?  @db.Text
  date         String   // Data escolhida
  hour         String   // Hora escolhida
  status       String   @default("PENDENTE") // PENDENTE -> EM_MANUTENCAO -> CONCLUIDO
  description  String?  @default("Aguardando receção da viatura") // O que aparece no "Status"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// ENUMS (DADOS PADRONIZADOS)
// ==========================================

enum Role {
  USER
  ADMIN
}

enum FuelType {
  GASOLINA
  DIESEL
  HIBRIDO
  ELETRICO
}

enum ServiceType {
  REVISAO
  PNEUS
  OLEO
  TRAVOES
  DIAGNOSTICO
  OUTRO
}

enum ServiceStatus {
  PENDENTE
  EM_REPARACAO
  CONCLUIDO
}